@model IEnumerable<MiBanco.Application.Dtos.ClienteDto>
@{ ViewData["Title"] = "Clientes"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Clientes</h2>
    <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Create")">Agregar cliente</button>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Cédula</th><th>Nombre completo</th><th>Correo</th><th>Sucursal</th><th>Activo</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.Cedula</td>
                <td>@x.NombreCompleto</td>
                <td>@x.Email</td>
                <td>@x.SucursalTexto</td>
                <td>@x.Activo</td>
                <td class="text-end text-nowrap">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("Edit", new { id = x.Id })">Editar</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Action("Delete", new { id = x.Id })">Eliminar</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>