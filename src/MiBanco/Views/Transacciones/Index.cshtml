@model IEnumerable<MiBanco.Application.Dtos.TransaccionDto>
@{ ViewData["Title"] = "Transacciones"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Transacciones</h2>
    <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Create")">Agregar transacción</button>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Cuenta</th><th>Tipo</th><th>Monto ($)</th><th>Fecha</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.CuentaTexto</td>
                <td>@(x.Tipo == "D" ? "Depósito" : "Retiro")</td>
                <td>@x.Monto.ToString("N2")</td>
                <td>@x.Fecha.ToString("dd/MM/yyyy")</td>
                <td class="text-end text-nowrap">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("Edit", new { id = x.Id })">Editar</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Action("Delete", new { id = x.Id })">Eliminar</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>