@model IEnumerable<MiBanco.Application.Dtos.CuentaDto>
@{ ViewData["Title"] = "Cuentas"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Cuentas</h2>
    <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Create")">Agregar cuenta</button>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Número de cuenta</th><th>Fecha de apertura</th><th>Cliente</th><th>Tipo de cuenta</th><th>Saldo</th><th>Moneda</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.NumeroCuenta</td>
                <td>@x.FechaApertura.ToString("dd/MM/yyyy")</td>
                <td>@x.ClienteTexto</td>
                <td>@x.TipoCuentaTexto</td>
                <td>@x.Moneda</td>
                <td class="text-end fw-semibold @(x.Saldo < 0 ? "text-danger" : "text-success")">$ @x.Saldo.ToString("N2")</td>
                <td class="text-end text-nowrap">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("Edit", new { id = x.Id })">Editar</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Action("Delete", new { id = x.Id })">Eliminar</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>